  "author": {
    "email": "carlitosnu41@gmail.com",
    "url": "https://carlosnunezmx.tech",
    "name": "CarlosNuñezMX"
  },
  "main": "source/index.ts",
  "module": "source/index.ts",
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/jsonwebtoken": "^9.0.10",
    "tsc-alias": "^1.8.16"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "bcrypt": "^5.1.1"
  },
  "bugs": {
    "email": "carlitosnu41@gmail.com",
    "url": "https://github.com/CarlosNunezMX/aru/issues"
  },
  "description": "Just another UdeG Leo Wrapper",
  "homepage": "https://github.com/CarlosNunezMX/aru",
  "type": "module",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "private": true,
  "scripts": {
    "build:package": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:types": "tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "build": "npm run build:package & npm run build:types",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/pkg/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./modules": {
      "import": "./dist/pkg/modules/index.js",
      "types": "./dist/types/modules/index.d.ts"
    },
    "./types": {
      "types": "./dist/types/interfaces/*.d.ts"
    }
  }
}
